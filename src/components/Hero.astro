---
import { site , phoneCta } from "@lib/site";
import TrustBadges from "./TrustBadges.astro";

interface Props {
  h1: string;
  lede: string;
  showBadges?: boolean;
}
const { h1, lede, showBadges = true } = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <h1>{h1}</h1>
    <p class="lede">{lede}</p>

    <div class="btn-row">
      <a class="btn btn-call" href={site.phone.href}>
        <span aria-hidden="true">&#9742;</span>
        {phoneCta}
      </a>
      <a class="btn btn-outline" href="/contact/">Get a quote</a>
    </div>

    {
      site.phone.acceptsText && (
        <p class="sms-note">
          Same number takes texts — send a photo of the damage and we'll tell you
          repair or replace.
        </p>
      )
    }

    {showBadges && <TrustBadges />}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem);
    background:
      linear-gradient(180deg, #f7f9fb 0%, #ffffff 100%);
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .hero .lede {
    margin-bottom: 1.75rem;
  }

  .sms-note {
    margin: 0.9rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    max-width: 52ch;
  }
</style>
