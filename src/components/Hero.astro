---
import { site, heroPhoto } from "@lib/site";
import TrustBadges from "./TrustBadges.astro";
import HeroArt from "./HeroArt.astro";

interface Props {
  h1: string;
  lede: string;
  showBadges?: boolean;
  /** Service pages keep the art; About doesn't need it. */
  showArt?: boolean;
  eyebrow?: string;
}
const {
  h1,
  lede,
  showBadges = true,
  showArt = true,
  eyebrow = "Mobile auto glass · Orange County, CA",
} = Astro.props;
---

<section class="hero">
  <div class:list={["wrap", "layout", { solo: !showArt }]}>
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>

      <div class="btn-row">
        {/* "Call" not "Call or Text" — the Text button beside it says that
            already, and the longer label wrapped the row onto two lines. */}
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          Call {site.phone.display}
        </a>
        {
          site.phone.acceptsText && (
            <a class="btn btn-ghost" href={site.phone.sms}>
              Text us
            </a>
          )
        }
        <a class="btn btn-quiet" href="#services">See services</a>
      </div>

      {showBadges && <TrustBadges />}
    </div>

    {
      showArt && (
        <figure class="art">
          {heroPhoto.src ? (
            <img
              class="hero-photo"
              src={heroPhoto.src}
              alt={heroPhoto.alt}
              width="650"
              height="433"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <HeroArt />
          )}
          {heroPhoto.src && heroPhoto.caption && (
            <figcaption>{heroPhoto.caption}</figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.75rem, 7vw, 5rem);
    background:
      radial-gradient(
        820px 420px at 78% 8%,
        rgba(56, 189, 248, 0.16) 0%,
        transparent 62%
      ),
      linear-gradient(165deg, #0b2438 0%, var(--brand-deep) 58%, #050f1c 100%);
    color: #ffffff;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .layout.solo {
    grid-template-columns: 1fr;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.79rem;
    font-weight: 800;
    color: var(--glass);
    margin-bottom: 0.9rem;
  }

  .hero h1 {
    /* Larger and tighter than the site default — this is the display headline. */
    font-size: clamp(2.3rem, 6.2vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 15ch;
    color: #fff;
    margin-bottom: 1.1rem;
  }

  .hero .lede {
    color: #a9c3d8;
    font-size: 1.12rem;
    max-width: 54ch;
    margin-bottom: 2rem;
  }

  .btn-row {
    gap: 0.65rem;
  }

  .btn-ghost {
    border-color: rgba(255, 255, 255, 0.55);
    color: #fff;
    background: transparent;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  .btn-quiet {
    color: #cfe0ee;
    background: rgba(255, 255, 255, 0.08);
  }

  .btn-quiet:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .art {
    margin: 0;
    justify-self: center;
  }

  .hero-photo,
  .art :global(.hero-art) {
    border-radius: 14px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.4);
  }

  .hero-photo {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .art figcaption {
    margin-top: 0.7rem;
    font-size: 0.86rem;
    color: #8fa9bf;
    max-width: 480px;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }

    /* Headline and call button own the fold; the image follows. */
    .art {
      order: 2;
      max-width: 360px;
      justify-self: start;
    }

    .hero h1 {
      max-width: 18ch;
    }
  }
</style>
