---
import { site, heroPhoto } from "@lib/site";
import TrustBadges from "./TrustBadges.astro";
import HeroArt from "./HeroArt.astro";
import { publishedCounties } from "../data/counties";

/**
 * Derived rather than hardcoded, same reasoning as TrustBadges' coverage
 * line — this fed the default eyebrow on 8 pages (home, every core service
 * page, both tools, contact, about) and stayed "Orange County, CA" only for
 * weeks after Los Angeles County actually published. City and county pages
 * override this with their own single-place eyebrow, so this default only
 * ever needs to represent the whole coverage area.
 */
const defaultEyebrow = `Mobile auto glass · ${publishedCounties
  .map((c) => c.name)
  .join(" & ")}, CA`;

interface Props {
  h1: string;
  lede: string;
  showBadges?: boolean;
  /** Service pages keep the art; About doesn't need it. */
  showArt?: boolean;
  eyebrow?: string;
  /** Hide the "See services" link on pages with no #services section. */
  showServicesLink?: boolean;
}
const {
  h1,
  lede,
  showBadges = true,
  showArt = true,
  eyebrow = defaultEyebrow,
  showServicesLink = true,
} = Astro.props;
---

<section class="hero">
  <div class:list={["wrap", "layout", { solo: !showArt }]}>
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>

      <div class="btn-row">
        {/* "Call" not "Call or Text" — the Text button beside it says that
            already, and the longer label wrapped the row onto two lines. */}
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          Call {site.phone.display}
        </a>
        {
          site.phone.acceptsText && (
            <a class="btn btn-ghost" href={site.phone.sms}>
              Text us
            </a>
          )
        }
        {showServicesLink && (
          <a class="btn btn-quiet" href="#services">See services</a>
        )}
      </div>

      {showBadges && <TrustBadges />}
    </div>

    {
      showArt && (
        <figure class="art">
          {heroPhoto.src ? (
            <img
              class="hero-photo"
              src={heroPhoto.src}
              alt={heroPhoto.alt}
              width="650"
              height="433"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <HeroArt />
          )}
          {heroPhoto.src && heroPhoto.caption && (
            <figcaption>{heroPhoto.caption}</figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.25rem, 9vw, 7rem);
    /* Fills more of the fold on desktop without pushing the CTA off it. */
    min-height: min(78vh, 720px);
    display: flex;
    align-items: center;
    background:
      radial-gradient(
        820px 420px at 78% 8%,
        rgba(127, 166, 156, 0.20) 0%,
        transparent 62%
      ),
      linear-gradient(165deg, var(--color-ink-raised) 0%, var(--color-ink) 62%, var(--color-ink-deep) 100%);
    color: var(--color-on-dark);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    width: 100%;
  }

  .layout.solo {
    grid-template-columns: 1fr;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.79rem;
    font-weight: 800;
    color: var(--color-glass);
    margin-bottom: 0.9rem;
  }

  .hero h1 {
    /* Larger and tighter than the site default — this is the display headline. */
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
    max-width: 14ch;
    color: var(--color-on-dark);
    margin-bottom: 1.25rem;
  }

  .hero .lede {
    color: var(--color-on-dark-soft);
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    max-width: 52ch;
    margin-bottom: 2.25rem;
  }

  .btn-row {
    gap: 0.6rem;
  }

  /* Slightly tighter than the global pill so all three fit one line at the
     width the copy column actually gets — it overflowed by ~6px otherwise. */
  .hero .btn {
    padding-inline: 1.3rem;
  }

  .btn-ghost {
    border-color: rgba(243, 241, 236, 0.5);
    color: var(--color-on-dark);
    background: transparent;
  }

  .btn-ghost:hover {
    background: rgba(243, 241, 236, 0.12);
    border-color: var(--color-on-dark);
  }

  .btn-quiet {
    color: var(--color-on-dark);
    background: rgba(243, 241, 236, 0.09);
  }

  .btn-quiet:hover {
    background: rgba(243, 241, 236, 0.17);
    color: var(--color-on-dark);
  }

  .art {
    margin: 0;
    justify-self: center;
  }

  .hero-photo,
  .art :global(.hero-art) {
    border-radius: 14px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.4);
  }

  .hero-photo {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .art figcaption {
    margin-top: 0.7rem;
    font-size: 0.86rem;
    color: var(--color-on-dark-soft);
    max-width: 480px;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }

    /* Headline and call button own the fold; the image follows. */
    .art {
      order: 2;
      max-width: 360px;
      justify-self: start;
    }

    .hero h1 {
      max-width: 18ch;
    }
  }
</style>
