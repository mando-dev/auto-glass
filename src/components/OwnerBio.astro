---
import { owner, PENDING } from "@lib/site";

/**
 * Hidden entirely until the client supplies a name, role, bio and a real photo.
 * This is the highest-converting block on a trade site, so it is worth chasing —
 * but an empty version of it is worse than its absence.
 */
---

{
  !PENDING.owner && (
    <section>
      <div class="wrap">
        <h2>Who's actually doing the work</h2>
        <div class="bio">
          {owner.photo && (
            <img
              src={owner.photo}
              alt={`${owner.name}, ${owner.role}`}
              width="220"
              height="220"
              loading="lazy"
            />
          )}
          <div>
            <h3>
              {owner.name} — {owner.role}
            </h3>
            <p>{owner.bio}</p>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .bio {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .bio img {
    border-radius: var(--radius);
    width: 220px;
    object-fit: cover;
  }

  .bio div {
    flex: 1 1 320px;
  }

  .bio p {
    color: var(--ink-soft);
    max-width: 62ch;
  }
</style>
