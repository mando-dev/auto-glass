---
import { cities, PENDING } from "@lib/site";
---

<section class="area">
  <div class="wrap">
    <h2>Where we work</h2>

    {
      PENDING.cities ? (
        // No city list until the client confirms the radius. Naming a city the
        // techs won't drive to costs a refund and a one-star review.
        <p class="lede">
          Mobile service across Orange County. Tell us where the vehicle is
          parked and we'll tell you straight away whether we cover it.
        </p>
      ) : (
        <>
          <p class="lede">
            Mobile service across Orange County. Every city below has a tech
            assigned to it.
          </p>
          <ul class="cities">
            {cities.map((c) => (
              <li>
                <a href={`/${c.slug}/`}>{c.name}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  /* Warm tint — the third hue in the page rhythm, so the run of blue and white
     sections gets broken up before the closing CTA band. */
  .area {
    background: var(--accent-tint);
    border-block: 1px solid #f6ddd0;
  }

  .cities {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .cities a {
    display: block;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }

  .cities a:hover {
    border-color: var(--brand);
    background: #f4f8fc;
  }
</style>
