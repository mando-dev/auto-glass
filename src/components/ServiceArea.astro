---
import { cities, PENDING } from "@lib/site";
---

<section>
  <div class="wrap">
    <h2>Where we work</h2>

    {
      PENDING.cities ? (
        <p class="pending-note">
          <strong>Build note — not for launch.</strong> City list and per-city
          pages are staged in <code>src/lib/site.ts</code> but stay hidden until
          the client confirms the actual service radius. Advertising a city the
          techs will not drive to costs a refund and a one-star review, so this
          is not a gap to fill by guessing.
        </p>
      ) : (
        <>
          <p class="lede">
            Mobile service across Orange County. Every city below has a tech
            assigned to it.
          </p>
          <ul class="cities">
            {cities.map((c) => (
              <li>
                <a href={`/${c.slug}/`}>{c.name}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  .cities {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .cities a {
    display: block;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }

  .cities a:hover {
    border-color: var(--brand);
    background: #f4f8fc;
  }

  .pending-note {
    border: 1px dashed #f0a868;
    background: #fffaf4;
    color: #8a4b08;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    font-size: 0.92rem;
    max-width: 70ch;
  }
</style>
