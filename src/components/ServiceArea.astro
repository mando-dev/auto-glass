---
import { cities, PENDING } from "@lib/site";
import { publishedCounties, countyPath } from "../data/counties";

/**
 * Compact version used on the homepage and elsewhere. The full page at
 * /service-area/ has cities grouped by county — this stays a flat quick-scan
 * list, with a link into the full page for anyone who wants the detail.
 *
 * The homepage adds a live Google Maps embed (showMap). It is a region query,
 * not an address: this is a service-area business with no public storefront,
 * so the map shows the county it covers and never pins a location. Lazy-loaded
 * inside a fixed aspect-ratio box so it costs nothing at first paint and
 * cannot shift layout when it arrives.
 */
interface Props {
  /** Homepage only — keeps the iframe off the pages that reuse this component. */
  showMap?: boolean;
}
const { showMap = false } = Astro.props;

const countyNames = publishedCounties.map((c) => c.name).join(" & ");
---

<section class="area">
  <div class="wrap">
    <h2>Where we work</h2>

    {
      PENDING.cities ? (
        // No city list until the client confirms the radius. Naming a city the
        // techs won't drive to costs a refund and a one-star review.
        <p class="lede">
          Mobile service across {countyNames}. Tell us where the vehicle is
          parked and we'll tell you straight away whether we cover it.
        </p>
      ) : (
        <>
          <p class="lede">
            Mobile service across {countyNames}. Each city below has its own
            page with the neighborhoods, freeways and ZIP codes it covers.
          </p>
          <ul class="cities">
            {cities.map((c) => (
              <li>
                <a href={c.href}>{c.name}</a>
              </li>
            ))}
            {publishedCounties.map((county) => (
              <li>
                <a class="hub" href={countyPath(county.slug)}>
                  All of {county.name}
                </a>
              </li>
            ))}
          </ul>

          {showMap && (
            <div class="map-frame">
              <iframe
                src="https://www.google.com/maps?q=Orange+County,+CA&z=9&output=embed"
                width="720"
                height="405"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Map of Orange County, California — the region our mobile auto glass service covers"
              ></iframe>
            </div>
          )}

          <p class="full-link">
            <a href="/service-area/">See the full coverage map &rsaquo;</a>
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  /* Warm tint — the third hue in the page rhythm, so the run of blue and white
     sections gets broken up before the closing CTA band. */
  .area {
    background: var(--color-paper-sunk);
    border-block: 1px solid var(--line);
  }

  .cities {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .cities a {
    display: block;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }

  .cities a:hover {
    border-color: var(--color-ink);
    background: var(--color-paper-sunk);
  }

  .cities .hub {
    color: var(--color-accent-deep);
  }

  .full-link {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }

  /* Reserved 16:9 box: the lazy iframe fills space that already exists, so
     it cannot shift layout when it loads. Full width on mobile. */
  .map-frame {
    margin: 1.5rem 0 0;
    width: 100%;
    max-width: 720px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-paper);
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
