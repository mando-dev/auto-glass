---
import { site } from "@lib/site";

/**
 * Quiet inline row, not boxed chips.
 *
 * Only states things already true in site.ts. No license number, no "Licensed &
 * Insured", no years in business — none of that is confirmed for this client,
 * and California does not license auto glass the way it licenses contracting
 * trades. Credentials appear here only once the client evidences them, at which
 * point the placeholder check stops filtering them out.
 */
const isPlaceholder = (value: string) => /^\[[A-Z0-9_]+\]$/.test(value);

const claims = [
  site.credentials.insured,
  site.credentials.certification,
  "Mobile across Orange County",
  site.phone.acceptsText ? "Call or text — photo quotes welcome" : "",
].filter((claim) => claim && !isPlaceholder(claim));
---

<ul class="trust">
  {claims.map((claim) => <li>{claim}</li>)}
</ul>

<style>
  .trust {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.9rem;
    color: #93aec5;
  }

  .trust li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trust li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }
</style>
