---
import { site } from "@lib/site";
import { publishedCounties } from "../data/counties";

/**
 * Quiet inline row, not boxed chips.
 *
 * Only states things already true in site.ts. No license number, no "Licensed &
 * Insured", no years in business — none of that is confirmed for this client,
 * and California does not license auto glass the way it licenses contracting
 * trades. Credentials appear here only once the client evidences them, at which
 * point the placeholder check stops filtering them out.
 */
const isPlaceholder = (value: string) => /^\[[A-Z0-9_]+\]$/.test(value);

// Derived from publishedCounties rather than hardcoded — this said "Mobile
// across Orange County" everywhere, including on LA County pages, from the
// day Cerritos and Whittier went live. Same class of drift as the nav link
// that pointed "Service Areas" at only the OC hub.
const coverageLabel =
  publishedCounties.length > 1
    ? `Mobile across ${publishedCounties.map((c) => c.name).join(" & ")}`
    : `Mobile across ${publishedCounties[0]?.name ?? "the area"}`;

const claims = [
  site.credentials.insured,
  site.credentials.certification,
  coverageLabel,
  site.phone.acceptsText ? "Call or text — photo quotes welcome" : "",
].filter((claim) => claim && !isPlaceholder(claim));
---

<ul class="trust">
  {claims.map((claim) => <li>{claim}</li>)}
</ul>

<style>
  .trust {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.9rem;
    color: var(--color-on-dark-soft);
  }

  .trust li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trust li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }
</style>
