---
import { site } from "@lib/site";

/**
 * Renders only what the client has evidenced. Anything unconfirmed renders as a
 * visibly dashed placeholder so gaps are obvious in client review instead of
 * being quietly filled with a plausible-sounding claim.
 *
 * Pending state is derived from the value itself rather than a PENDING flag —
 * credentials are supplied one at a time, and a shared flag either leaks a raw
 * [PLACEHOLDER] into the page or hides a credential that has already arrived.
 */
const isPlaceholder = (value: string) => /^\[[A-Z0-9_]+\]$/.test(value);

const badges = [
  { label: "Insured", value: site.credentials.insured },
  { label: "Certified", value: site.credentials.certification },
  { label: "Serving Orange County", value: "Mobile service countywide" },
].map((badge) => ({ ...badge, pending: isPlaceholder(badge.value) }));
---

<ul class="badges">
  {
    badges.map((b) => (
      <li class:list={["badge", { pending: b.pending }]}>
        <strong>{b.label}</strong>
        <span>{b.pending ? "pending client confirmation" : b.value}</span>
      </li>
    ))
  }
</ul>

<style>
  .badges {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .badge {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.55rem 0.9rem;
    background: #fff;
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .badge strong {
    color: var(--ink);
  }

  .badge span {
    color: var(--ink-soft);
  }

  .badge.pending {
    border-style: dashed;
    border-color: #f0a868;
    background: #fffaf4;
  }

  .badge.pending span {
    color: #8a4b08;
    font-style: italic;
  }
</style>
