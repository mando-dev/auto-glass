---
import { recentWork } from "@lib/site";
---

{
  recentWork.length > 0 && (
    <section class="section-soft">
      <div class="wrap">
        <h2>Recent work</h2>
        <p class="lede">Shot on the job, not staged.</p>
        <div class="grid grid-3">
          {recentWork.map((photo) => (
            <figure class="shot">
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                width="600"
                height="400"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .shot {
    margin: 0;
  }

  .shot img {
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--line);
  }

  .shot figcaption {
    font-size: 0.9rem;
    color: var(--color-on-light-soft);
    margin-top: 0.5rem;
  }
</style>
