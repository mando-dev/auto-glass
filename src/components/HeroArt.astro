---
/**
 * Original artwork. Inline SVG rather than a raster file so it costs no extra
 * request on the LCP path, scales without artefacts, and carries no licensing
 * question — competitor photography is not an option and stock reads as fake.
 *
 * Decorative: the headline already carries the meaning, so it is hidden from
 * assistive tech rather than given a description that repeats the h1.
 */
---

<svg
  class="hero-art"
  viewBox="0 0 520 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="glassFill" x1="90" y1="40" x2="430" y2="320">
      <stop offset="0%" stop-color="#dcefff" />
      <stop offset="45%" stop-color="#b7dcf7" />
      <stop offset="100%" stop-color="#8ec5ec" />
    </linearGradient>
    <linearGradient id="skyStreak" x1="120" y1="60" x2="380" y2="300">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="chipGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#c2410c" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#c2410c" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Roof / pillar frame -->
  <path
    d="M78 300 L128 58 Q132 40 150 40 L370 40 Q388 40 392 58 L442 300 Z"
    fill="#0d1723"
  />

  <!-- Glass -->
  <path
    d="M96 288 L143 70 Q146 56 160 56 L360 56 Q374 56 377 70 L424 288 Z"
    fill="url(#glassFill)"
  />

  <!-- Reflection streak -->
  <path
    d="M96 288 L143 70 Q146 56 160 56 L232 56 L150 288 Z"
    fill="url(#skyStreak)"
  />

  <!-- Wipers -->
  <path
    d="M150 272 L246 186"
    stroke="#0d1723"
    stroke-width="7"
    stroke-linecap="round"
    opacity="0.5"
  />
  <path
    d="M262 272 L352 190"
    stroke="#0d1723"
    stroke-width="7"
    stroke-linecap="round"
    opacity="0.5"
  />

  <!-- Rear-view mirror -->
  <rect x="242" y="56" width="42" height="17" rx="6" fill="#0d1723" opacity="0.65" />

  <!-- Impact chip: glow, star legs, core -->
  <circle cx="320" cy="132" r="46" fill="url(#chipGlow)" />
  <g stroke="#c2410c" stroke-width="2.6" stroke-linecap="round">
    <path d="M320 132 L349 106" />
    <path d="M320 132 L353 145" />
    <path d="M320 132 L332 166" />
    <path d="M320 132 L294 158" />
    <path d="M320 132 L288 120" />
    <path d="M320 132 L306 101" />
  </g>
  <circle cx="320" cy="132" r="7.5" fill="#c2410c" />
  <circle cx="317.5" cy="129.5" r="2.6" fill="#ffffff" opacity="0.9" />

  <!-- Hairline crack running from the chip -->
  <path
    d="M332 166 Q338 196 327 214 Q318 230 326 250"
    stroke="#c2410c"
    stroke-width="2.2"
    stroke-linecap="round"
    opacity="0.55"
  />

  <!-- Ground line -->
  <path
    d="M40 300 L480 300"
    stroke="#0d1723"
    stroke-width="5"
    stroke-linecap="round"
    opacity="0.12"
  />
</svg>

<style>
  .hero-art {
    width: 100%;
    max-width: 440px;
    height: auto;
    display: block;
  }
</style>
