---
import { reviews, site } from "@lib/site";

/** Renders nothing until real reviews exist. Never writes one on the client's behalf. */
---

{
  reviews.length > 0 ? (
    <section class="section-soft">
      <div class="wrap">
        <h2>What customers actually said</h2>
        <p class="lede">
          These are unedited reviews from the same profile you see when you
          search us — not testimonials we wrote.
        </p>

        <div class="grid grid-3">
          {reviews.map((r) => (
            <figure class="card">
              <blockquote>{r.quote}</blockquote>
              <figcaption>
                {r.author} &middot;{" "}
                <a href={r.url} rel="nofollow noopener" target="_blank">
                  on {r.platform}
                </a>
              </figcaption>
            </figure>
          ))}
        </div>

        {site.social.google && (
          <p class="all-link">
            <a href={site.social.google} rel="nofollow noopener" target="_blank">
              Read every review on Google
            </a>
          </p>
        )}
      </div>
    </section>
  ) : null
}

<style>
  blockquote {
    margin: 0 0 1rem;
    font-size: 1.02rem;
  }

  blockquote::before {
    content: open-quote;
  }
  blockquote::after {
    content: close-quote;
  }

  figcaption {
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .all-link {
    margin-top: 1.5rem;
    font-weight: 700;
  }
</style>
