---
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
}
const { faqs, heading = "Common questions" } = Astro.props;
---

<section class="section-soft">
  <div class="wrap">
    <h2>{heading}</h2>
    <div class="faqs">
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faqs {
    max-width: 78ch;
    display: grid;
    gap: 0.6rem;
  }

  details {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 0 1.15rem;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    padding: 1rem 0;
    list-style-position: outside;
  }

  details p {
    color: var(--color-on-light-soft);
    margin-top: 0;
    padding-bottom: 1rem;
    max-width: 68ch;
  }
</style>
