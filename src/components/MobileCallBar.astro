---
import { site } from "@lib/site";
---

{/* Separate Call and Text actions — the full "Call or Text <number>" label does
    not fit a 375px bar, and sms: is a better tap target than a hint to text. */}
<div class="callbar">
  <a class="btn btn-call" href={site.phone.href}>
    <span aria-hidden="true">&#9742;</span>
    Call
  </a>
  {
    site.phone.acceptsText && (
      <a class="btn btn-text" href={site.phone.sms}>
        Text
      </a>
    )
  }
  <a class="btn btn-quote" href="/contact/">Quote</a>
</div>

<style>
  .callbar {
    display: none;
  }

  @media (max-width: 760px) {
    .callbar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 30;
      padding: 0.55rem 0.75rem calc(0.55rem + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(6px);
      border-top: 1px solid var(--line);
    }

    .callbar .btn {
      padding: 0.75rem 0.9rem;
      font-size: 0.97rem;
      width: 100%;
      white-space: nowrap;
    }

    .btn-text {
      background: var(--brand);
      color: #fff;
    }

    .btn-quote {
      background: var(--bg-soft);
      color: var(--brand);
      border-color: var(--line);
    }
  }
</style>
