---
import { site, services, cities, contentPages, PENDING } from "@lib/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="fbrand">{site.name}</p>
      <p class="muted">{site.tagline}</p>
      <p>
        <a class="fcall" href={site.phone.href}>{site.phone.display}</a>
      </p>
    </div>

    <div>
      <h2>Services</h2>
      <ul>
        {
          services.map((s) => (
            <li>
              <a href={`/${s.slug}/`}>{s.name}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2>Service Area</h2>
      {
        PENDING.cities ? (
          <p class="muted">Mobile service across Orange County, California.</p>
        ) : (
          <ul>
            {cities.map((c) => (
              <li>
                <a href={`/${c.slug}/`}>{c.name}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      <h2>Company</h2>
      <ul>
        {
          contentPages.map((page) => (
            <li>
              <a href={page.href}>{page.label}</a>
            </li>
          ))
        }
      </ul>
      {/* Careers link intentionally omitted — add only once the client confirms
          they are hiring techs. */}
    </div>
  </div>

  <div class="wrap legal">
    <p>&copy; {year} {site.name}. Orange County, California.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #0d1620;
    color: #c7d0d9;
    padding-block: 3rem 1.5rem;
    margin-top: 2rem;
  }

  .cols {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .site-footer h2 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #8fa0b0;
    margin-bottom: 0.75rem;
  }

  .fbrand {
    font-weight: 800;
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 0.35rem;
  }

  .muted {
    color: #8fa0b0;
    font-size: 0.92rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .site-footer a {
    color: #c7d0d9;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .fcall {
    font-weight: 700;
    font-size: 1.08rem !important;
    color: #fff !important;
  }

  .legal {
    border-top: 1px solid #23303e;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
  }

  .legal p {
    margin: 0;
    font-size: 0.85rem;
    color: #7c8b99;
  }
</style>
