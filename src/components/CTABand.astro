---
import { site } from "@lib/site";

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Tell us the car and the damage. We'll tell you repair or replace.",
  body = "Send a photo of the chip and we can usually say straight away whether it fills or needs new glass.",
} = Astro.props;
---

<section class="band">
  <div class="wrap inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-call" href={site.phone.href}>
        <span aria-hidden="true">&#9742;</span>
        Call {site.phone.display}
      </a>
      <a class="btn btn-light" href="/contact/">Send photos</a>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--brand-dark);
    color: #fff;
  }

  .inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .band h2 {
    max-width: 24ch;
    margin-bottom: 0.4rem;
  }

  .band p {
    margin: 0;
    color: #c4dcf3;
    max-width: 52ch;
  }

  .btn-light {
    background: #fff;
    color: var(--brand-dark);
  }

  .btn-light:hover {
    background: #e7f1fa;
  }
</style>
