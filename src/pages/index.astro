---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import ServiceCards from "@components/ServiceCards.astro";
import OwnerBio from "@components/OwnerBio.astro";
import RecentWork from "@components/RecentWork.astro";
import Reviews from "@components/Reviews.astro";
import ServiceArea from "@components/ServiceArea.astro";
import CTABand from "@components/CTABand.astro";
import { site , phoneCta } from "@lib/site";
import { publishedCounties } from "../data/counties";

const countyNames = publishedCounties.map((c) => c.name).join(" and ");

const title = `Auto Glass Repair — Orange & LA County | ${site.name}`;
const description =
  "Mobile auto glass across Orange County and LA County. Fleet vehicles handled in your yard, plus chip repair and windshield replacement for personal cars.";

/**
 * Positioning drawn from what is structurally true of a mobile, independent
 * operation. Still worth the client confirming #2 and #4 specifically — who
 * actually answers the phone, and whether fleets get consolidated scheduling.
 */
const reasons = [
  {
    title: "The van comes to you",
    body: "Driveway, office lot, job site. You keep working, we do the glass. Nobody sits in a waiting room reading a two-year-old magazine.",
  },
  {
    title: "You talk to the tech, not a call center",
    body: "The person who picks up is the person who shows up. No dispatch queue, no being handed between three departments to book one windshield.",
  },
  {
    title: "We'll tell you when you don't need new glass",
    body: "Plenty of chips fill with resin for a fraction of a replacement. If yours is one of them we say so, even though the smaller job pays us less.",
  },
  {
    title: "Fleets get one point of contact",
    body: "Multiple vehicles get scheduled together and handled in one visit, so your trucks aren't going offline one at a time across three weeks.",
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <Hero
    h1="Your vehicles get fixed where they're parked."
    lede={`Mobile auto glass across ${countyNames}. Fleet vans and work trucks handled in your yard, before the shift starts — and the car in your driveway too. Chip repair, crack repair and full windshield replacement, without anything leaving the lot.`}
  />

  <section class="fleet-lead">
    <div class="wrap">
      <p class="eyebrow">Fleet &amp; commercial</p>
      <h2>A cracked windshield is a vehicle that isn't earning</h2>
      <p class="lede">
        Vans, box trucks, work pickups, rideshare vehicles. Glass damage takes a
        vehicle off the road on the day you can least spare it, and sending each
        one to a shop individually turns one problem into a week of them.
      </p>

      <div class="fleet-points">
        <div>
          <h3>We come to the yard</h3>
          <p>
            Multiple vehicles handled in a single visit, where they already
            park. Nothing gets driven anywhere for glass.
          </p>
        </div>
        <div>
          <h3>Scheduled around your shifts</h3>
          <p>
            Overnight or between runs, so vehicles aren't coming off the road
            during the hours they're supposed to be working.
          </p>
        </div>
        <div>
          <h3>One point of contact</h3>
          <p>
            Tell us the vehicles and where they sit. You don't chase a dispatch
            queue once per truck.
          </p>
        </div>
      </div>

      <div class="btn-row">
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          {phoneCta}
        </a>
        <a class="btn btn-outline" href="/contact/">Set up a fleet account</a>
      </div>

    </div>
  </section>

  <ServiceCards heading="What we do" />

  <section class="section-soft">
    <div class="wrap">
      <h2>How we work</h2>
      <ol class="reasons">
        {
          reasons.map((r) => (
            <li>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ol>

    </div>
  </section>

  <section>
    <div class="wrap personal">
      <p class="eyebrow">Personal vehicles</p>
      <h2>One car, same deal</h2>
      <p class="lede">
        We didn't build this around fleets to the exclusion of everyone else. If
        it's your own car, the work happens in your driveway or your office lot
        while you get on with the day — no drop-off, no arranging a ride home,
        no afternoon in a waiting room.
      </p>
      <div class="btn-row">
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          {phoneCta}
        </a>
        <a class="btn btn-outline" href="/contact/">Get a quote</a>
      </div>
    </div>
  </section>

  <OwnerBio />
  <RecentWork />
  <Reviews />
  <ServiceArea />
  <CTABand />
</BaseLayout>

<style>
  .reasons {
    list-style: none;
    counter-reset: reason;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  }

  .reasons li {
    counter-increment: reason;
  }

  .reasons h3::before {
    content: counter(reason);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    margin-right: 0.7rem;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--color-ink) 0%, var(--color-ink) 100%);
    color: #fff;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .reasons h3 {
    display: flex;
    align-items: center;
  }

  .reasons p {
    color: var(--color-on-light-soft);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }

  /*
   * Same --color-ink as the hero, per the palette. The two are adjacent, so a
   * sage rule divides them — without it they merge into one two-screen slab.
   * The slightly raised tone does the rest of the separation.
   */
  .fleet-lead {
    background:
      radial-gradient(
        760px 360px at 88% 0%,
        rgba(127, 166, 156, 0.14) 0%,
        transparent 62%
      ),
      var(--color-ink-raised);
    color: var(--color-on-dark-soft);
    border-top: 3px solid var(--color-glass);
  }

  .fleet-lead h2 {
    max-width: 20ch;
    color: var(--color-on-dark);
  }

  .fleet-lead .eyebrow {
    color: var(--color-glass);
  }

  .fleet-lead .lede,
  .fleet-lead .fleet-points p {
    color: var(--color-on-dark-soft);
  }

  .fleet-lead .fleet-points h3 {
    color: var(--color-on-dark);
  }

  .fleet-lead .fleet-points > div {
    border-top: 2px solid var(--line-dark);
    padding-top: 1rem;
  }

  .fleet-lead .btn-outline {
    color: var(--color-on-dark);
  }

  .fleet-lead .btn-outline:hover {
    background: rgba(243, 241, 236, 0.1);
  }

  .fleet-points {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 2rem 0;
  }

  .fleet-points h3 {
    margin-bottom: 0.3rem;
  }

  .fleet-points p {
    color: var(--color-on-light-soft);
    margin: 0;
  }

  .personal {
    max-width: 68ch;
  }

  .personal .btn-row {
    margin-top: 1.5rem;
  }
</style>
