---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import ServiceCards from "@components/ServiceCards.astro";
import OwnerBio from "@components/OwnerBio.astro";
import RecentWork from "@components/RecentWork.astro";
import Reviews from "@components/Reviews.astro";
import ServiceArea from "@components/ServiceArea.astro";
import CTABand from "@components/CTABand.astro";
import { site } from "@lib/site";

const title = `Mobile Auto Glass Repair in Orange County | ${site.name}`;
const description =
  "Mobile auto glass across Orange County. Fleet and commercial vehicles handled in your yard between shifts, plus chip repair and windshield replacement for personal cars. Nothing leaves the lot.";

/**
 * Positioning drafted from what is structurally true of a mobile, independent
 * operation. Every one of these still needs client sign-off before launch —
 * see the build note rendered under the section.
 */
const reasons = [
  {
    title: "The van comes to you",
    body: "Driveway, office lot, job site. You keep working, we do the glass. Nobody sits in a waiting room reading a two-year-old magazine.",
  },
  {
    title: "You talk to the tech, not a call center",
    body: "The person who picks up is the person who shows up. No dispatch queue, no being handed between three departments to book one windshield.",
  },
  {
    title: "We'll tell you when you don't need new glass",
    body: "Plenty of chips fill with resin for a fraction of a replacement. If yours is one of them we say so, even though the smaller job pays us less.",
  },
  {
    title: "Fleets get one point of contact",
    body: "Multiple vehicles get scheduled together and handled in one visit, so your trucks aren't going offline one at a time across three weeks.",
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <Hero
    h1="Your vehicles get fixed where they're parked."
    lede="Mobile auto glass across Orange County. Fleet vans and work trucks handled in your yard, before the shift starts — and the car in your driveway too. Chip repair, crack repair and full windshield replacement, without anything leaving the lot."
  />

  <section class="fleet-lead">
    <div class="wrap">
      <p class="eyebrow">Fleet &amp; commercial</p>
      <h2>A cracked windshield is a vehicle that isn't earning</h2>
      <p class="lede">
        Vans, box trucks, work pickups, rideshare vehicles. Glass damage takes a
        vehicle off the road on the day you can least spare it, and sending each
        one to a shop individually turns one problem into a week of them.
      </p>

      <div class="fleet-points">
        <div>
          <h3>We come to the yard</h3>
          <p>
            Multiple vehicles handled in a single visit, where they already
            park. Nothing gets driven anywhere for glass.
          </p>
        </div>
        <div>
          <h3>Scheduled around your shifts</h3>
          <p>
            Overnight or between runs, so vehicles aren't coming off the road
            during the hours they're supposed to be working.
          </p>
        </div>
        <div>
          <h3>One point of contact</h3>
          <p>
            Tell us the vehicles and where they sit. You don't chase a dispatch
            queue once per truck.
          </p>
        </div>
      </div>

      <div class="btn-row">
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          Call {site.phone.display}
        </a>
        <a class="btn btn-outline" href="/contact/">Set up a fleet account</a>
      </div>

      <p class="pending-note">
        <strong>Build note — not for launch.</strong> Fleet is framed here as the
        priority audience per the brief, using only claims that follow from
        running a mobile operation. Anything commercial buyers usually ask about
        next — net payment terms, invoicing, insurer billing, minimum vehicle
        counts, whether there's a dedicated account contact — is deliberately
        absent because none of it is confirmed. Ask the client which of those
        they actually offer; each one is a strong addition and a bad guess.
      </p>
    </div>
  </section>

  <ServiceCards heading="What we do" />

  <section class="section-soft">
    <div class="wrap">
      <h2>Why people call us back</h2>
      <ol class="reasons">
        {
          reasons.map((r) => (
            <li>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="pending-note">
        <strong>Build note — not for launch.</strong> These four reasons are
        drafted positioning, not client-supplied fact. Each needs a yes from the
        client before launch — particularly #2 (who actually answers the phone)
        and #4 (whether fleets really get consolidated scheduling).
      </p>
    </div>
  </section>

  <section>
    <div class="wrap personal">
      <p class="eyebrow">Personal vehicles</p>
      <h2>One car, same deal</h2>
      <p class="lede">
        We didn't build this around fleets to the exclusion of everyone else. If
        it's your own car, the work happens in your driveway or your office lot
        while you get on with the day — no drop-off, no arranging a ride home,
        no afternoon in a waiting room.
      </p>
      <div class="btn-row">
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          Call {site.phone.display}
        </a>
        <a class="btn btn-outline" href="/contact/">Get a quote</a>
      </div>
    </div>
  </section>

  <OwnerBio />
  <RecentWork />
  <Reviews />
  <ServiceArea />
  <CTABand />
</BaseLayout>

<style>
  .reasons {
    list-style: none;
    counter-reset: reason;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  }

  .reasons li {
    counter-increment: reason;
  }

  .reasons h3::before {
    content: counter(reason);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    margin-right: 0.6rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: 0.95rem;
  }

  .reasons h3 {
    display: flex;
    align-items: center;
  }

  .reasons p {
    color: var(--ink-soft);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--brand);
    margin-bottom: 0.4rem;
  }

  .fleet-lead {
    border-bottom: 1px solid var(--line);
  }

  .fleet-lead h2 {
    max-width: 20ch;
  }

  .fleet-points {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 2rem 0;
  }

  .fleet-points h3 {
    margin-bottom: 0.3rem;
  }

  .fleet-points p {
    color: var(--ink-soft);
    margin: 0;
  }

  .personal {
    max-width: 68ch;
  }

  .personal .btn-row {
    margin-top: 1.5rem;
  }

  .pending-note {
    margin-top: 2rem;
    border: 1px dashed #f0a868;
    background: #fffaf4;
    color: #8a4b08;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    font-size: 0.92rem;
    max-width: 70ch;
  }
</style>
