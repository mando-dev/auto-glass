---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import FAQ from "@components/FAQ.astro";
import LeadForm from "@components/LeadForm.astro";
import ServiceCards from "@components/ServiceCards.astro";
import CTABand from "@components/CTABand.astro";
import { serviceBySlug, site } from "@lib/site";
import { serviceSchema, faqSchema, breadcrumbSchema } from "@lib/schema";

const service = serviceBySlug("windshield-replacement")!;

const faqs = [
  {
    q: "When does a windshield need replacing instead of repairing?",
    a: "Broadly: damage longer than a dollar bill, anything sitting in the driver's direct line of sight, chips right at the edge of the glass where the structural bond is, and any damage that has gone through both layers. If it's smaller and away from the edge, ask about a chip repair first — it's cheaper and keeps the factory seal intact.",
  },
  {
    q: "How long does a windshield replacement take?",
    a: "The removal and set is usually an hour to ninety minutes. What actually governs your day is the safe drive-away time afterwards while the urethane cures. The tech will give you the exact figure for the adhesive used on your vehicle.",
  },
  {
    q: "Can you replace a windshield at my home or office in Irvine?",
    a: "Yes — replacements are done mobile across Irvine and the rest of Orange County, provided the vehicle is somewhere dry and out of direct rain. See our mobile auto glass page for how the visit works.",
  },
  {
    q: "Will you use the right glass for my vehicle?",
    a: "Windshields differ by trim, not just by model — rain sensors, heated wiper parks, acoustic interlayers, HUD projection areas and camera brackets all change the part. Give us the year, make, model and trim and we'll source glass that matches the original specification.",
  },
  {
    q: "Does insurance cover it?",
    a: "That depends entirely on your policy and deductible, and it's worth a call to your insurer before you book anything. We can't tell you what your policy does — but we can give you what you need to ask them: the vehicle, the damage, and what the job involves.",
  },
];

const schemas = [
  serviceSchema(service.slug, "Windshield Replacement", service.metaDescription),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Windshield Replacement", url: "/windshield-replacement/" },
  ]),
];
---

<BaseLayout
  title={`${service.title} | ${site.name}`}
  description={service.metaDescription}
  path="/windshield-replacement/"
  schemas={schemas}
>
  <Hero
    h1={service.h1}
    lede="When the crack is past saving, the glass comes out and new glass goes in — at your address, matched to your vehicle's actual specification, and set with the cure time the adhesive genuinely needs."
  />

  <section>
    <div class="wrap prose">
      <h2>Replacement is a structural repair, not a cosmetic one</h2>
      <p>
        It's easy to think of a windshield as a window. It isn't. It's bonded
        into the body shell and it carries load — it holds the roof up in a
        rollover and it's the surface the passenger airbag pushes against when
        it deploys. A windshield that's been set badly, or driven on before the
        adhesive cured, can fail in exactly the moment it's needed.
      </p>
      <p>
        Which is why the parts of this job that don't look impressive are the
        parts that matter: cleaning the pinch weld properly, priming bare metal
        so it doesn't corrode under the new bond, laying an even urethane bead,
        and then actually waiting out the cure.
      </p>

      <h2>Windshield replacement in Irvine and across Orange County</h2>
      <p>
        Replacements are done mobile. We come to your home or workplace in
        Irvine or anywhere else in the county we cover, set the glass where the
        car is parked, and tell you plainly when it's safe to drive. The only
        real requirement is somewhere dry — fresh adhesive and rain don't mix.
      </p>

      <h2>Before you book a replacement, check it isn't repairable</h2>
      <p>
        Not every crack needs new glass, and a resin repair keeps the original
        factory bond — which is always better than any replacement, however well
        done. Send a photo before you commit to anything. If it fills, we'll
        tell you it fills.
      </p>
      <p>
        <a href="/windshield-chip-repair/">See chip and crack repair &rsaquo;</a>
      </p>

      <h2>If your vehicle has a camera on the windshield</h2>
      <p>
        Many vehicles from roughly 2018 onward mount a forward-facing camera to
        the glass for lane keeping and automatic emergency braking. On those, the
        camera's aim is tied to the windshield it's mounted to, so replacing the
        glass affects it.
      </p>
      <p>
        Tell us the year, make and model when you get in touch and we'll tell you
        whether yours is one of them and how it gets handled.
      </p>
    </div>
  </section>

  <FAQ faqs={faqs} heading="Windshield replacement — common questions" />

  <section>
    <div class="wrap narrow">
      <LeadForm
        source="Windshield Replacement page"
        heading="Get a replacement quote"
      />
    </div>
  </section>

  <ServiceCards heading="Other services" exclude={service.slug} />
  <CTABand
    heading="Not sure if it's repairable? Send a photo."
    body={`Text the chip to ${site.phone.display} and we'll tell you straight whether it fills or needs new glass.`}
  />
</BaseLayout>

<style>
  .prose {
    max-width: 74ch;
  }

  .narrow {
    max-width: 760px;
  }
</style>
