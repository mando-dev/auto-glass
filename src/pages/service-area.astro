---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import ServiceMap from "@components/ServiceMap.astro";
import LeadForm from "@components/LeadForm.astro";
import CTABand from "@components/CTABand.astro";
import { site, phoneCta } from "@lib/site";
import { serviceSchema, breadcrumbSchema } from "@lib/schema";
import { publishedCities, cityPath } from "../data/cities";
import { publishedCounties, countyPath } from "../data/counties";

/**
 * The "where do you cover, overall" page — both counties together, distinct
 * from the per-county hubs at /orange-county/ and /los-angeles-county/.
 *
 * Everything on it derives from the same published data the footer and the
 * schema use, so the three cannot disagree: the city list rendered here, the
 * footer's Service Area column and this page's areaServed (via
 * serviceSchema's default) are all publishedCities grouped by
 * publishedCounties. Every city links to its real page — no plain-text city
 * names, no placeholder links, no unpublished cities.
 *
 * No address anywhere: service-area business, no public storefront. The map
 * is centred on the region and pins nothing — see ServiceMap.astro.
 */
const path = "/service-area/";
const pageName = "Mobile Auto Glass Service Area";
const countyNames = publishedCounties.map((c) => c.name).join(" & ");

const title = "Service Area — Orange County & LA County";
const h1 = `${pageName}: Orange County & LA County`;
const description =
  "Mobile windshield repair and replacement across Orange County and Los Angeles County. Every city we cover, a map of the region, and how mobile service works.";

const trail = [
  { name: "Home", url: "/" },
  { name: "Service Area", url: path },
];

const schemas = [
  serviceSchema(path, pageName, description),
  breadcrumbSchema(trail),
];

const byCounty = publishedCounties
  .map((county) => ({
    county,
    cities: publishedCities.filter((c) => c.county === county.key),
  }))
  .filter((group) => group.cities.length > 0);
---

<BaseLayout title={`${title} | ${site.name}`} description={description} path={path} schemas={schemas}>
  <Breadcrumbs trail={trail} />

  <Hero
    h1={h1}
    eyebrow={`Mobile auto glass · ${countyNames}`}
    lede="Chip repair, crack repair and full windshield replacement, done at the address where the vehicle already sits. We cover mobile auto glass across Orange County, plus the neighbouring LA County cities listed below."
    showArt={false}
    showServicesLink={false}
  />

  <section>
    <div class="wrap">
      <h2>Cities we cover</h2>
      <p class="lede">
        Each city links to its own page, with the neighborhoods, freeways and ZIP
        codes it covers.
      </p>

      <div class="counties">
        {
          byCounty.map(({ county, cities }) => (
            <div class="county">
              <h3>
                <a href={countyPath(county.slug)}>{county.name}</a>
              </h3>
              <ul class="cities">
                {cities.map((c) => (
                  <li>
                    <a href={cityPath(c.slug)}>{c.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="map">
        <ServiceMap />
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap prose">
      <h2>How mobile service works</h2>
      <p>
        There's no shop to drive to. The van carries the glass, the resin kit and
        the urethane, and the work happens where the vehicle is already parked —
        a driveway at home, a workplace parking lot or structure, or a fleet yard
        where several vehicles can be done in one visit.
      </p>
      <p>
        Tell us where the vehicle is, the year, make and model, and ideally a
        photo of the damage. We'll tell you whether it's a repair or a
        replacement and when we can get there. If you're just outside one of the
        cities above, ask anyway — we'll say plainly whether we can reach you.
      </p>
      <div class="btn-row">
        <a class="btn btn-call" href={site.phone.href}>
          <span aria-hidden="true">&#9742;</span>
          {phoneCta}
        </a>
        {
          site.phone.acceptsText && (
            <a class="btn btn-outline" href={site.phone.sms}>
              Text a photo
            </a>
          )
        }
      </div>
      {
        site.phone.acceptsText && (
          <p class="text-note">
            {site.phone.display} takes texts as well as calls — a photo of the
            damage is often all we need to tell you repair or replace.
          </p>
        )
      }
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <LeadForm source="Service Area page" heading="Get a quote for your vehicle" />
    </div>
  </section>

  <CTABand
    heading="Not sure we reach you?"
    body={`Text your city and the damage to ${site.phone.display} — we'll say plainly whether we can get there and when.`}
  />
</BaseLayout>

<style>
  .prose {
    max-width: 68ch;
  }

  .narrow {
    max-width: 760px;
  }

  .counties {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 1.75rem;
  }

  .county h3 {
    font-size: 1.05rem;
    margin-bottom: 0.7rem;
  }

  .county h3 a {
    text-decoration: none;
  }

  .county h3 a:hover {
    text-decoration: underline;
  }

  .cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }

  .cities a {
    display: block;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .cities a:hover {
    border-color: var(--color-ink);
  }

  .map {
    margin-top: 2rem;
  }

  .btn-row {
    margin-top: 1.5rem;
  }

  .text-note {
    margin-top: 0.9rem;
    font-size: 0.93rem;
    color: var(--color-on-light-soft);
  }
</style>
