---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CTABand from "@components/CTABand.astro";
import { site } from "@lib/site";
import { breadcrumbSchema } from "@lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  // No author person is claimed — nobody real has been attributed to this yet.
  publisher: { "@type": "Organization", name: site.name, url: site.url },
  mainEntityOfPage: `${site.url}/blog/${post.id}/`,
};

const schemas = [
  articleSchema,
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: post.data.title, url: `/blog/${post.id}/` },
  ]),
];

const fmt = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  schemas={schemas}
>
  <article>
    <section>
      <div class="wrap prose">
        <p class="back"><a href="/blog/">&lsaquo; All guides</a></p>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {fmt(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span> · updated {fmt(post.data.updatedDate)}</span>
            )
          }
        </p>

        <div class="body">
          <Content />
        </div>
      </div>
    </section>
  </article>

  <CTABand />
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }

  .back {
    margin-bottom: 1rem;
  }

  .back a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .meta {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .body :global(h2) {
    margin-top: 2.25rem;
  }

  .body :global(h3) {
    margin-top: 1.75rem;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--ink-soft);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  /* display:block so a wide table scrolls itself instead of the page body. */
  .body :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--line);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }

  .body :global(th) {
    background: var(--bg-soft);
  }

  .body :global(strong) {
    color: var(--ink);
  }
</style>
