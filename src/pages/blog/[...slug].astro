---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CTABand from "@components/CTABand.astro";
import { site, services } from "@lib/site";
import { breadcrumbSchema } from "@lib/schema";
import { cityBySlug, cityPath, type City } from "../../data/cities";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  // No author person is claimed — nobody real has been attributed to this yet.
  publisher: { "@type": "Organization", name: site.name, url: site.url },
  mainEntityOfPage: `${site.url}/blog/${post.id}/`,
};

const schemas = [
  articleSchema,
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: post.data.title, url: `/blog/${post.id}/` },
  ]),
];

/**
 * Related links. Every post supports one service page and a couple of city
 * pages; rendering them from frontmatter guarantees the links exist even when
 * the body forgets one. Unpublished cities silently drop out.
 */
const relatedService = post.data.relatedService
  ? services.find((s) => `/${s.slug}/` === post.data.relatedService)
  : undefined;
const relatedCities = post.data.relatedCities
  .map((slug) => cityBySlug(slug))
  .filter((c): c is City => Boolean(c));

const fmt = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  schemas={schemas}
>
  <article>
    <section>
      <div class="wrap prose">
        <p class="back"><a href="/blog/">&lsaquo; All guides</a></p>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {fmt(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span> · updated {fmt(post.data.updatedDate)}</span>
            )
          }
        </p>

        <div class="body">
          <Content />
        </div>

        {
          (relatedService || relatedCities.length > 0) && (
            <aside class="related">
              <h2>Related</h2>
              <ul>
                {relatedService && (
                  <li>
                    <a href={`/${relatedService.slug}/`}>{relatedService.name}</a>
                  </li>
                )}
                {relatedCities.map((c) => (
                  <li>
                    <a href={cityPath(c.slug)}>Windshield repair in {c.name}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </section>
  </article>

  <CTABand />
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }

  .back {
    margin-bottom: 1rem;
  }

  .back a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .meta {
    color: var(--color-on-light-soft);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .body :global(h2) {
    margin-top: 2.25rem;
  }

  .body :global(h3) {
    margin-top: 1.75rem;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--color-on-light-soft);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  /* display:block so a wide table scrolls itself instead of the page body. */
  .body :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--line);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }

  .body :global(th) {
    background: var(--color-paper-sunk);
  }

  .body :global(strong) {
    color: var(--color-on-light);
  }

  .related {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-on-light-soft);
    margin-bottom: 0.6rem;
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-weight: 600;
  }

  .related a {
    text-decoration: none;
  }

  .related a:hover {
    text-decoration: underline;
  }
</style>
