---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CTABand from "@components/CTABand.astro";
import FAQ from "@components/FAQ.astro";
import CallTextButtons from "@components/CallTextButtons.astro";
import { site, services } from "@lib/site";
import { breadcrumbSchema, faqSchema } from "@lib/schema";
import { cityBySlug, cityPath, type City } from "../../data/cities";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  // No author person is claimed — nobody real has been attributed to this yet.
  publisher: { "@type": "Organization", name: site.name, url: site.url },
  mainEntityOfPage: `${site.url}/blog/${post.id}/`,
};

const schemas = [
  articleSchema,
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: post.data.title, url: `/blog/${post.id}/` },
  ]),
  ...(post.data.faq.length > 0 ? [faqSchema(post.data.faq)] : []),
];

/**
 * Related links. Every post supports one service page and a couple of city
 * pages; rendering them from frontmatter guarantees the links exist even when
 * the body forgets one. Unpublished cities silently drop out.
 */
const relatedService = post.data.relatedService
  ? services.find((s) => `/${s.slug}/` === post.data.relatedService)
  : undefined;
const relatedCities = post.data.relatedCities
  .map((slug) => cityBySlug(slug))
  .filter((c): c is City => Boolean(c));

/**
 * "More guides": the next three posts in a fixed rotation, so every post ends
 * up with exactly three incoming links from other posts. Without this each
 * post is linked only from the blog index, which leaves a page with a single
 * internal link pointing at it.
 *
 * A "same topic first, then newest" ordering was tried and rejected: it piles
 * every link onto the same few posts and starves the rest. Posts are grouped
 * by the service they support, so neighbours in the rotation are mostly
 * related, and the order is deterministic so a build never reshuffles links.
 */
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const ordered = [...allPosts].sort(
  (a, b) =>
    (a.data.relatedService ?? "").localeCompare(b.data.relatedService ?? "") ||
    a.id.localeCompare(b.id),
);
const at = ordered.findIndex((p) => p.id === post.id);
const moreGuides = Array.from(
  { length: Math.min(3, ordered.length - 1) },
  (_, k) => ordered[(at + 1 + k) % ordered.length],
);

const fmt = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  schemas={schemas}
  ogType="article"
>
  <article>
    <section>
      <div class="wrap prose">
        <p class="back"><a href="/blog/">&lsaquo; All guides</a></p>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {fmt(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span> · updated {fmt(post.data.updatedDate)}</span>
            )
          }
        </p>

        <div class="body">
          <Content />
        </div>

        {
          relatedService && (
            <aside class="get-fixed">
              <h2>Get it fixed</h2>
              <p>
                Ready to have it looked at? See how{" "}
                <a href={`/${relatedService.slug}/`}>
                  {relatedService.name.toLowerCase()}
                </a>{" "}
                works, or call or text {site.phone.display} with the year, make
                and model and a photo of the damage.
              </p>
              <div class="btn-row">
                <CallTextButtons textLabel="Text a photo" />
              </div>
            </aside>
          )
        }

        {
          (relatedService || relatedCities.length > 0) && (
            <aside class="related">
              <h2>Related</h2>
              <ul>
                {relatedService && (
                  <li>
                    <a href={`/${relatedService.slug}/`}>{relatedService.name}</a>
                  </li>
                )}
                {relatedCities.map((c) => (
                  <li>
                    <a href={cityPath(c.slug)}>Windshield repair in {c.name}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        {
          moreGuides.length > 0 && (
            <aside class="more">
              <h2>More guides</h2>
              <ul>
                {moreGuides.map((p) => (
                  <li>
                    <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </section>
  </article>

  {post.data.faq.length > 0 && <FAQ faqs={post.data.faq} heading="Common questions" />}

  <CTABand />
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }

  .back {
    margin-bottom: 1rem;
  }

  .back a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .meta {
    color: var(--color-on-light-soft);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .body :global(h2) {
    margin-top: 2.25rem;
  }

  .body :global(h3) {
    margin-top: 1.75rem;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--color-on-light-soft);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  /* display:block so a wide table scrolls itself instead of the page body. */
  .body :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--line);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }

  .body :global(th) {
    background: var(--color-paper-sunk);
  }

  .body :global(strong) {
    color: var(--color-on-light);
  }

  .get-fixed {
    margin-top: 2.5rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-left: 5px solid var(--color-glass);
    border-radius: var(--radius);
    background: var(--color-paper-sunk);
  }

  .get-fixed h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .get-fixed p {
    color: var(--color-on-light-soft);
  }

  .more {
    margin-top: 1.75rem;
  }

  .more h2 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-on-light-soft);
    margin-bottom: 0.6rem;
  }

  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-weight: 600;
  }

  .more a {
    text-decoration: none;
  }

  .more a:hover {
    text-decoration: underline;
  }

  .related {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-on-light-soft);
    margin-bottom: 0.6rem;
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-weight: 600;
  }

  .related a {
    text-decoration: none;
  }

  .related a:hover {
    text-decoration: underline;
  }
</style>
