---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CTABand from "@components/CTABand.astro";
import { site } from "@lib/site";
import { breadcrumbSchema } from "@lib/schema";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
  ]),
];

const fmt = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout
  title={`Auto Glass Advice & Guides | ${site.name}`}
  description="Straight answers about windshield damage, repairs, replacements and insurance — written for people trying to work out what their car actually needs."
  path="/blog/"
  schemas={schemas}
>
  <section>
    <div class="wrap">
      <h1>Advice &amp; guides</h1>
      <p class="lede">
        Practical writing about windshield damage and what to do about it. No
        sales pitch — if the answer is "that doesn't need us", it says so.
      </p>

      {
        posts.length === 0 ? (
          <p class="empty">First posts are on the way.</p>
        ) : (
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <article>
                  <h2>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  <p class="meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {fmt(post.data.pubDate)}
                    </time>
                  </p>
                  <p>{post.data.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .posts {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    max-width: 74ch;
  }

  .posts h2 {
    font-size: 1.35rem;
    margin-bottom: 0.3rem;
  }

  .posts h2 a {
    text-decoration: none;
  }

  .posts h2 a:hover {
    text-decoration: underline;
  }

  .meta {
    color: var(--ink-soft);
    font-size: 0.88rem;
    margin-bottom: 0.4rem;
  }

  .posts p:last-child {
    color: var(--ink-soft);
    margin: 0;
  }

  .empty {
    margin-top: 2rem;
    color: var(--ink-soft);
  }
</style>
