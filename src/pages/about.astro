---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import OwnerBio from "@components/OwnerBio.astro";
import RecentWork from "@components/RecentWork.astro";
import Reviews from "@components/Reviews.astro";
import ServiceArea from "@components/ServiceArea.astro";
import CTABand from "@components/CTABand.astro";
import { site } from "@lib/site";
import { breadcrumbSchema } from "@lib/schema";

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "About", url: "/about/" },
  ]),
];
---

<BaseLayout
  title={`About ${site.name} | Orange County Auto Glass`}
  description="Who we are, how we work, and what we will and won't tell you about your windshield. Mobile auto glass across Orange County."
  path="/about/"
  schemas={schemas}
>
  <Hero
    h1="A small mobile glass operation, not a franchise."
    lede="The van, the tools and the person answering the phone are all part of the same small outfit. That's the whole pitch."
    showBadges={false}
  />

  <section>
    <div class="wrap prose">
      <h2>How we'd rather work</h2>
      <p>
        Auto glass has a reputation problem, and it's mostly earned. Quotes that
        change once someone's looking at the car. Chips that mysteriously always
        need a full replacement. Cure times that get quietly skipped because the
        next job is across the county.
      </p>
      <p>
        None of that is difficult to avoid. It just requires being willing to
        book fewer jobs a day and to occasionally talk someone out of the
        expensive option. That's the operating principle here, and it's the
        thing we'd ask to be judged on.
      </p>

      <div class="pending-note">
        <strong>Build note — not for launch.</strong> This page's voice is drafted,
        not client-supplied. Before launch it needs: how long they've been doing
        glass, what they did before, why they went out on their own, and whether
        the anti-upsell positioning above is genuinely how they operate. If it
        isn't, this page should be rewritten rather than softened — a promise the
        business won't keep is worse than no promise.
      </div>
    </div>
  </section>

  <OwnerBio />
  <RecentWork />
  <Reviews />
  <ServiceArea />
  <CTABand />
</BaseLayout>

<style>
  .prose {
    max-width: 74ch;
  }

  .pending-note {
    border: 1px dashed #f0a868;
    background: #fffaf4;
    color: #8a4b08;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    font-size: 0.92rem;
    margin-top: 2rem;
  }
</style>
